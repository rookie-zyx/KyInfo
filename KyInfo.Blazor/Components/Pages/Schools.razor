@page "/schools"
@using KyInfo.Contracts.Schools
@using KyInfo.Blazor.ApiClient
@inject SchoolsApiClient SchoolsApi

<PageTitle>院校查询</PageTitle>

<RequireLogin>
<div class="section-header">
    <div class="section-header-title">
        <h1>院校查询</h1>
    </div>
    <p class="section-tagline mb-0">按名称、省份、层次快速筛选院校，点击列表查看详情与官网链接。</p>
</div>

<div class="card card-soft mb-3">
    <div class="card-header card-soft-header">
        <strong>筛选条件</strong>
    </div>
    <div class="card-body">
        <div class="ky-filter-form">
            <div class="ky-filter-field">
                <label class="form-label" for="school-keyword">关键词</label>
                <input id="school-keyword" class="form-control" placeholder="院校名称或简称，如 清华大学" @bind="keyword" />
            </div>
            <div class="ky-filter-field">
                <label class="form-label" for="school-province">省份</label>
                <input id="school-province" class="form-control" placeholder="如 北京、江苏" @bind="province" />
            </div>
            <div class="ky-filter-field">
                <label class="form-label" for="school-level">层次标签</label>
                <input id="school-level" class="form-control" placeholder="如 985、211、双一流" @bind="levelTag" />
            </div>
            <div class="ky-filter-actions">
                <button type="button" class="btn btn-primary btn-ky" @onclick="LoadSchools" disabled="@loading">
                    @(loading ? "查询中..." : "开始查询")
                </button>
            </div>
        </div>
    </div>
</div>

<div class="schools-split-row">
    <div class="schools-split-list">
        <div class="card card-soft h-100">
            <div class="card-header card-soft-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>院校列表</strong>
                    <span class="ms-2 text-muted small">
                        共 @(schools?.Count ?? 0) 所院校
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                @if (loading)
                {
                    <div class="p-3 text-muted">加载中...</div>
                }
                else if (schools is null || !schools.Any())
                {
                    <div class="ky-empty-state">
                        <span class="bi bi-building ky-empty-state-icon" aria-hidden="true"></span>
                        <p class="ky-empty-state-title">未找到院校</p>
                        <p class="ky-empty-state-hint">请调整筛选条件后重新查询。</p>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var s in schools)
                        {
                            <li class="list-group-item list-group-item-action" @onclick="@(() => LoadDetail(s.Id))" style="cursor: pointer;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@s.Name</strong>
                                        @if (!string.IsNullOrEmpty(s.ShortName))
                                        {
                                            <span class="text-muted">（@s.ShortName）</span>
                                        }
                                        <div class="text-muted small">@s.Province / @s.City</div>
                                    </div>
                                    <div class="text-end small">
                                        <div><span class="pill-badge pill-level-985">@s.LevelTag</span></div>
                                        <div class="text-muted mt-1">@s.Type · @s.Property</div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="schools-split-detail">
        <div class="card card-soft h-100">
            <div class="card-header card-soft-header">
                <strong>院校详情</strong>
            </div>
            <div class="card-body">
                @if (selected is null)
                {
                    <div class="ky-empty-state py-4">
                        <span class="bi bi-arrow-left-circle ky-empty-state-icon" aria-hidden="true"></span>
                        <p class="ky-empty-state-title">选择一所院校</p>
                        <p class="ky-empty-state-hint">点击左侧列表中的院校，此处将展示详细信息与官网链接。</p>
                    </div>
                }
                else
                {
                    <h5 class="card-title mb-1">
                        @selected.Name @(string.IsNullOrEmpty(selected.ShortName) ? "" : $"（{selected.ShortName}）")
                    </h5>
                    <p class="text-muted small mb-3">@selected.Province / @selected.City</p>
                    <p class="card-text mb-1">
                        <span class="pill-badge pill-level-985 me-1">@selected.LevelTag</span>
                        <span class="pill-badge pill-badge-muted me-1">@selected.Type</span>
                        <span class="pill-badge pill-badge-muted">@selected.Property</span>
                    </p>
                    @if (!string.IsNullOrEmpty(selected.Website))
                    {
                        <p class="card-text mt-3">
                            官网：
                            <a href="@selected.Website" target="_blank" rel="noopener">@selected.Website</a>
                        </p>
                    }
                }
            </div>
        </div>
    </div>
</div>

</RequireLogin>

@code {
    private bool loading;
    private string keyword = "";
    private string province = "";
    private string levelTag = "";

    private List<SchoolListItemDto>? schools;
    private SchoolDetailDto? selected;

    protected override async Task OnInitializedAsync()
    {
        await LoadSchools();
    }

    private async Task LoadSchools()
    {
        loading = true;
        selected = null;
        try
        {
            schools = await SchoolsApi.SearchAsync(keyword, province, levelTag);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadDetail(int id)
    {
        selected = await SchoolsApi.GetByIdAsync(id);
    }

}
