@page "/scoreline-trends"
@using KyInfo.Contracts.ScoreLines
@using KyInfo.Blazor.ApiClient
@inject ScoreLinesApiClient ScoreLinesApi

<PageTitle>分数线趋势</PageTitle>

<RequireLogin>
<div class="section-header">
    <div class="section-header-title">
        <h1>分数线趋势</h1>
    </div>
    <p class="section-tagline mb-0">按年份查看国家线与院校线变化，选择院校 / 专业与类型后绘制趋势图。</p>
</div>

<div class="card card-soft mb-3">
    <div class="card-header card-soft-header">
        <strong>筛选条件</strong>
    </div>
    <div class="card-body">
        <div class="ky-filter-form">
            <div class="ky-filter-field">
                <label class="form-label" for="trend-school-name">院校名称（可选）</label>
                <input id="trend-school-name" class="form-control" placeholder="输入院校名称，如 清华大学" @bind="schoolNameText" />
            </div>
            <div class="ky-filter-field">
                <label class="form-label" for="trend-major-name">专业名称（可选）</label>
                <input id="trend-major-name" class="form-control" placeholder="输入专业名称，如 计算机科学与技术" @bind="majorNameText" />
            </div>
            <div class="ky-filter-field">
                <label class="form-label" for="trend-type">类型</label>
                <select id="trend-type" class="form-select" @bind="isNationalText">
                    <option value="">全部</option>
                    <option value="true">国家线</option>
                    <option value="false">院校/专业线</option>
                </select>
            </div>
            <div class="ky-filter-actions">
                <button type="button" class="btn btn-primary btn-ky" @onclick="Load" disabled="@loading">
                    @(loading ? "加载中..." : "绘制趋势图")
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-warning" role="alert">@error</div>
}

@if (loading)
{
    <div class="ky-skeleton" style="min-height: 12rem;" aria-label="加载中"></div>
}
else if (points is null)
{
    <div class="ky-empty-state">
        <span class="bi bi-bar-chart-line ky-empty-state-icon" aria-hidden="true"></span>
        <p class="ky-empty-state-title">尚未绘制趋势图</p>
        <p class="ky-empty-state-hint">设置筛选条件后，点击「绘制趋势图」查看近年分数线走势。</p>
    </div>
}
else if (!points.Any())
{
    <div class="ky-empty-state">
        <span class="bi bi-inbox ky-empty-state-icon" aria-hidden="true"></span>
        <p class="ky-empty-state-title">暂无匹配数据</p>
        <p class="ky-empty-state-hint">请确认已录入对应分数线，或放宽院校 / 专业筛选条件。</p>
    </div>
}
else
{
    <div class="card card-soft">
        <div class="card-header card-soft-header">
            <strong>分数线趋势图</strong>
            <span class="ms-2 text-muted small">共 @points.Count 个年份 · 纵轴为同年平均分</span>
        </div>
        <div class="card-body">
            <svg width="100%" viewBox="0 0 600 300" preserveAspectRatio="none" style="background-color:#f8fafc;border-radius:4px;" role="img" aria-label="分数线趋势折线图">
                <line x1="50" y1="20" x2="50" y2="260" stroke="#ccc" stroke-width="1" />
                <line x1="50" y1="260" x2="580" y2="260" stroke="#ccc" stroke-width="1" />

                @foreach (var tick in YTicks)
                {
                    var ty = MapY(tick);
                    <line x1="50" y1="@ty" x2="580" y2="@ty" stroke="#eee" stroke-width="1" />
                    @:<text x="45" y="@ty" text-anchor="end" dominant-baseline="middle" font-size="10">@tick</text>
                }

                @foreach (var xt in XTicks)
                {
                    @:<text x="@xt.x" y="275" text-anchor="middle" font-size="10">@xt.year</text>
                }

                <polyline points="@PolylinePoints" fill="none" stroke="#3b82f6" stroke-width="2" />

                @foreach (var p in points)
                {
                    var (x, y) = MapPoint(p);
                    <circle cx="@x" cy="@y" r="3" fill="#3b82f6" />
                }
            </svg>
        </div>
    </div>
}

</RequireLogin>
@code {
    private bool loading;
    private string schoolNameText = "";
    private string majorNameText = "";
    private string isNationalText = "";
    private string? error;

    private List<ScoreLineTrendPointDto>? points;

    private IReadOnlyList<int> YTicks => points is null || !points.Any()
        ? Array.Empty<int>()
        : Enumerable.Range(0, 5)
            .Select(i => MinScore + (MaxScore - MinScore) * i / 4)
            .ToList();

    private IReadOnlyList<(int year, double x)> XTicks => points is null || !points.Any()
        ? Array.Empty<(int, double)>()
        : points.Select(p => (p.Year, MapX(p.Year))).ToList();

    private int MinScore => points!.Min(p => p.Score);
    private int MaxScore => points!.Max(p => p.Score);

    private string PolylinePoints => points is null
        ? ""
        : string.Join(" ",
            points.Select(p =>
            {
                var (x, y) = MapPoint(p);
                return $"{x},{y}";
            }));

    private async Task Load()
    {
        error = null;
        points = null;

        loading = true;
        try
        {
            bool? isNational = bool.TryParse(isNationalText, out var n) ? n : null;
            var schoolName = string.IsNullOrWhiteSpace(schoolNameText) ? null : schoolNameText.Trim();
            var majorName = string.IsNullOrWhiteSpace(majorNameText) ? null : majorNameText.Trim();

            points = await ScoreLinesApi.GetTrendAsync(null, null, isNational, schoolName, majorName);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            points = new List<ScoreLineTrendPointDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private (double x, double y) MapPoint(ScoreLineTrendPointDto p)
    {
        var x = MapX(p.Year);
        var y = MapY(p.Score);
        return (x, y);
    }

    private double MapX(int year)
    {
        if (points is null || points.Count == 0) return 50;
        var minYear = points.Min(p => p.Year);
        var maxYear = points.Max(p => p.Year);
        if (minYear == maxYear) return 315;

        var t = (year - minYear) / (double)(maxYear - minYear);
        return 50 + t * (580 - 50);
    }

    private double MapY(int score)
    {
        if (points is null || points.Count == 0) return 260;
        var min = MinScore;
        var max = MaxScore;
        if (min == max) return 140;

        var t = (score - min) / (double)(max - min);
        return 260 - t * (260 - 20);
    }
}
