@page "/scorelines"
@using KyInfo.Contracts.ScoreLines
@using KyInfo.Blazor.ApiClient
@inject ScoreLinesApiClient ScoreLinesApi

<PageTitle>分数线</PageTitle>

<RequireLogin>
<div class="section-header">
    <div class="section-header-title">
        <h1>分数线查询</h1>
    </div>
    <p class="section-tagline mb-0">查看国家线与各院校 / 专业历史分数线，支持按年份、院校、专业和类型筛选。</p>
</div>

<div class="card card-soft mb-3">
    <div class="card-header card-soft-header">
        <strong>筛选条件</strong>
    </div>
    <div class="card-body">
        <div class="ky-filter-form">
            <div class="ky-filter-field">
                <label class="form-label" for="sl-school">院校（可选）</label>
                <input id="sl-school" class="form-control" placeholder="输入院校 Id，留空查全部" @bind="schoolIdText" />
            </div>
            <div class="ky-filter-field">
                <label class="form-label" for="sl-major">专业（可选）</label>
                <input id="sl-major" class="form-control" placeholder="输入专业 Id，留空查全部" @bind="majorIdText" />
            </div>
            <div class="ky-filter-field">
                <label class="form-label" for="sl-year">年份</label>
                <input id="sl-year" class="form-control" placeholder="如 2025，留空表示不限" @bind="yearText" />
            </div>
            <div class="ky-filter-field">
                <label class="form-label" for="sl-type">类型</label>
                <select id="sl-type" class="form-select" @bind="isNationalText">
                    <option value="">全部</option>
                    <option value="true">国家线</option>
                    <option value="false">院校/专业线</option>
                </select>
            </div>
            <div class="ky-filter-actions">
                <button type="button" class="btn btn-primary btn-ky" @onclick="Load" disabled="@loading">
                    @(loading ? "查询中..." : "查询")
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-warning" role="alert">@error</div>
}

<div class="card card-soft">
    <div class="card-header card-soft-header">
        <strong>分数线列表</strong>
        <span class="ms-2 text-muted small">共 @(items?.Count ?? 0) 条记录</span>
    </div>
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="p-3 text-muted">加载中...</div>
        }
        else if (items is null || !items.Any())
        {
            <div class="ky-empty-state">
                <span class="bi bi-table ky-empty-state-icon" aria-hidden="true"></span>
                <p class="ky-empty-state-title">暂无分数线数据</p>
                <p class="ky-empty-state-hint">调整上方筛选条件后点击「查询」。</p>
            </div>
        }
        else
        {
            <div class="ky-mobile-cards">
                @foreach (var x in items)
                {
                    <div class="ky-mobile-card">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <strong>@x.Year 年 · @x.Score 分</strong>
                            <span class="pill-badge @(x.IsNational ? "pill-national" : "pill-school-line")">
                                @(x.IsNational ? "国家线" : "院校/专业线")
                            </span>
                        </div>
                        <div class="small text-muted">@(x.SchoolName ?? "—") · @(x.MajorName ?? "—")</div>
                    </div>
                }
            </div>
            <div class="table-responsive d-none d-sm-block">
                <table class="table table-sm table-ky mb-0">
                    <thead>
                        <tr>
                            <th>年份</th>
                            <th>分数</th>
                            <th>类型</th>
                            <th>院校</th>
                            <th>专业</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in items)
                        {
                            <tr>
                                <td>@x.Year</td>
                                <td>@x.Score</td>
                                <td>
                                    <span class="pill-badge @(x.IsNational ? "pill-national" : "pill-school-line")">
                                        @(x.IsNational ? "国家线" : "院校/专业线")
                                    </span>
                                </td>
                                <td>@(x.SchoolName ?? "—")</td>
                                <td>@(x.MajorName ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

</RequireLogin>
@code {
    private bool loading;
    private string schoolIdText = "";
    private string majorIdText = "";
    private string yearText = "";
    private string isNationalText = "";
    private List<ScoreLineListItemDto>? items;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        error = null;
        loading = true;
        try
        {
            int? schoolId = int.TryParse(schoolIdText, out var sid) ? sid : null;
            int? majorId = int.TryParse(majorIdText, out var mid) ? mid : null;
            int? year = int.TryParse(yearText, out var y) ? y : null;
            bool? isNational = bool.TryParse(isNationalText, out var n) ? n : null;

            items = await ScoreLinesApi.SearchAsync(schoolId, majorId, year, isNational);
        }
        catch (ApiException ex)
        {
            items = new List<ScoreLineListItemDto>();
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
